rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /movements/{id} {
      allow read: if admin();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['name','quantity','note','createdBy','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0 && request.resource.data.quantity <= 1000000
        && request.resource.data.note is string && request.resource.data.note.size() <= 1000
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /donations/{id} {
      allow read: if admin();
      allow create: if signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.keys().hasOnly(['uid','name','email','model','note','department','center','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.model is string && request.resource.data.model.size() <= 120
        && request.resource.data.note is string && request.resource.data.note.size() <= 1000
        && request.resource.data.department == 'Matagalpa'
        && request.resource.data.center == 'matagalpa-el-progreso'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
